<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PduManagerWeb</AssemblyName>
    <RootNamespace>PduManager.Web</RootNamespace>
  </PropertyGroup>

  <!-- Drivers, models and storage are shared with the desktop app (no duplicate code). -->
  <ItemGroup>
    <Compile Include="..\PduManager\Models\PduConfig.cs" Link="Shared\PduConfig.cs" />
    <Compile Include="..\PduManager\Drivers\*.cs" Link="Shared\Drivers\%(Filename)%(Extension)" />
    <Compile Include="..\PduManager\Services\CredentialStore.cs" Link="Shared\CredentialStore.cs" />
    <Compile Include="..\PduManager\Services\ConfigStore.cs" Link="Shared\ConfigStore.cs" />
    <Compile Include="..\PduManager\Services\AutoPowerOffMonitor.cs" Link="Shared\AutoPowerOffMonitor.cs" />
  </ItemGroup>

  <!-- The UI is embedded so the published exe is a single file. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
